# Copy to .env and fill in. Never commit .env.
# Run with: uv run --env-file .env snowflake-obs

# --- Snowflake (required) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_WAREHOUSE=

# --- Snowflake (optional, defaults shown) ---
SNOWFLAKE_DATABASE=OBSERVABILITY_DB
SNOWFLAKE_SCHEMA=OBSERVABILITY_SCHEMA
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/rsa_key.p8
# Only set if the .p8 key is encrypted (i.e. not generated with -nocrypt).
SNOWFLAKE_PK_PASSPHRASE=

# --- LangSmith (required) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=

# --- LangSmith (optional, defaults shown) ---
LANGSMITH_OTEL_ENDPOINT=https://api.smith.langchain.com/otel/v1/traces

# --- Bridge state (optional, defaults shown) ---
SNOWFLAKE_OBS_CURSOR_PATH=.snowflake_bridge_cursor
